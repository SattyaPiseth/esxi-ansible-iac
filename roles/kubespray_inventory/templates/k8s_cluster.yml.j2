---
# Generated by esxi-ansible-iac. Keep source values in inventories/production.
kube_network_plugin: "{{ kubespray_inventory_network_plugin }}"
kube_proxy_mode: "{{ kubespray_inventory_kube_proxy_mode }}"
kube_proxy_metrics_bind_address: "{{ kubespray_inventory_kube_proxy_metrics_bind_address }}"
kube_proxy_strict_arp: {{ (((kubespray_inventory_enable_kube_vip | bool) and (kubespray_inventory_enable_kube_vip_arp | bool)) or (kubespray_inventory_enable_metallb | bool)) | lower }}
{% if kubespray_inventory_enable_kube_vip %}
kube_vip_enabled: true
kube_vip_controlplane_enabled: {{ kubespray_inventory_enable_kube_vip_controlplane | bool | lower }}
kube_vip_services_enabled: {{ kubespray_inventory_enable_kube_vip_services | bool | lower }}
kube_vip_arp_enabled: {{ kubespray_inventory_enable_kube_vip_arp | bool | lower }}
kube_vip_lb_enable: {{ kubespray_inventory_enable_kube_vip_lb | bool | lower }}
kube_vip_address: "{{ kubespray_inventory_kube_vip_address }}"
loadbalancer_apiserver:
  address: "{{ kubespray_inventory_kube_vip_address }}"
  port: 6443
{% endif %}
dns_mode: "{{ kubespray_inventory_dns_mode }}"
enable_nodelocaldns: {{ kubespray_inventory_enable_nodelocaldns | bool | lower }}
nodelocaldns_ip: "{{ kubespray_inventory_nodelocaldns_ip }}"
nodelocaldns_health_port: {{ kubespray_inventory_nodelocaldns_health_port }}
kubelet_rotate_server_certificates: {{ kubespray_inventory_enable_kubelet_server_certificate_rotation | bool | lower }}
{% if kubespray_inventory_enable_kubelet_server_certificate_rotation | bool %}
kubelet_csr_approver_values:
{{ kubespray_inventory_kubelet_csr_approver_values | to_nice_yaml(indent=2, sort_keys=false) | indent(2, true) }}
{% endif %}
kube_service_addresses: "{{ kubespray_inventory_service_cidr }}"
kube_pods_subnet: "{{ kubespray_inventory_pod_cidr }}"
calico_datastore: "{{ kubespray_inventory_calico_datastore }}"
calico_network_backend: "{{ kubespray_inventory_calico_network_backend }}"
calico_ipip_mode: "{{ kubespray_inventory_calico_ipip_mode }}"
calico_vxlan_mode: "{{ kubespray_inventory_calico_vxlan_mode }}"
kubeconfig_localhost: true
kubectl_localhost: true
