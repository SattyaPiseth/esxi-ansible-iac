---
# Generated by esxi-ansible-iac. Keep source values in inventories/production.
{% if kubespray_inventory_enable_helm | bool %}
helm_enabled: {{ kubespray_inventory_enable_helm | bool | lower }}
{% endif %}
{% if kubespray_inventory_enable_registry | bool %}
registry_enabled: {{ kubespray_inventory_enable_registry | bool | lower }}
{% endif %}

{% if kubespray_inventory_enable_metrics_server | bool %}
metrics_server_enabled: {{ kubespray_inventory_enable_metrics_server | bool | lower }}
metrics_server_kubelet_insecure_tls: {{ kubespray_inventory_enable_metrics_server_kubelet_insecure_tls | bool | lower }}
{% if kubespray_inventory_metrics_server_limits_cpu | length > 0 %}
metrics_server_limits_cpu: "{{ kubespray_inventory_metrics_server_limits_cpu }}"
{% endif %}
{% if kubespray_inventory_metrics_server_limits_memory | length > 0 %}
metrics_server_limits_memory: "{{ kubespray_inventory_metrics_server_limits_memory }}"
{% endif %}
{% if kubespray_inventory_metrics_server_requests_cpu | length > 0 %}
metrics_server_requests_cpu: "{{ kubespray_inventory_metrics_server_requests_cpu }}"
{% endif %}
{% if kubespray_inventory_metrics_server_requests_memory | length > 0 %}
metrics_server_requests_memory: "{{ kubespray_inventory_metrics_server_requests_memory }}"
{% endif %}
{% endif %}

{% if kubespray_inventory_enable_cert_manager | bool %}
cert_manager_enabled: {{ kubespray_inventory_enable_cert_manager | bool | lower }}
{% endif %}

{% if kubespray_inventory_enable_local_path_provisioner | bool %}
local_path_provisioner_enabled: {{ kubespray_inventory_enable_local_path_provisioner | bool | lower }}
local_path_provisioner_storage_class: "{{ kubespray_inventory_local_path_storage_class }}"
local_path_provisioner_reclaim_policy: {{ kubespray_inventory_local_path_reclaim_policy }}
{% endif %}

{% if kubespray_inventory_enable_metallb | bool %}
metallb_enabled: true
metallb_speaker_enabled: true
{% endif %}

{% if kubespray_inventory_enable_argocd | bool %}
argocd_enabled: {{ kubespray_inventory_enable_argocd | bool | lower }}
{% endif %}
